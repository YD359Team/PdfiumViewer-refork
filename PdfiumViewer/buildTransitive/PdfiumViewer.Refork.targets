<Project>
  <PropertyGroup>
    <_PdfiumViewerNativeX86>$(NuGetPackageRoot)pdfiumviewer.native.x86.v8-xfa/2018.4.8.256/Build/x86/pdfium.dll</_PdfiumViewerNativeX86>
    <_PdfiumViewerNativeX64>$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa/2018.4.8.256/Build/x64/pdfium.dll</_PdfiumViewerNativeX64>
  </PropertyGroup>

  <Target Name="PdfiumViewerRefork_CopyNativeToOutput" AfterTargets="Build">
    <Error Condition="!Exists('$(_PdfiumViewerNativeX86)')" Text="PdfiumViewer.Refork: x86 PDFium asset not found. Restore NuGet packages again." />
    <Error Condition="!Exists('$(_PdfiumViewerNativeX64)')" Text="PdfiumViewer.Refork: x64 PDFium asset not found. Restore NuGet packages again." />
    <MakeDir Directories="$(OutDir)x86;$(OutDir)x64" />
    <Copy SourceFiles="$(_PdfiumViewerNativeX86)" DestinationFiles="$(OutDir)x86/pdfium.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_PdfiumViewerNativeX64)" DestinationFiles="$(OutDir)x64/pdfium.dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PdfiumViewerRefork_CopyNativeToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Error Condition="!Exists('$(_PdfiumViewerNativeX86)')" Text="PdfiumViewer.Refork: x86 PDFium asset not found. Restore NuGet packages again." />
    <Error Condition="!Exists('$(_PdfiumViewerNativeX64)')" Text="PdfiumViewer.Refork: x64 PDFium asset not found. Restore NuGet packages again." />
    <MakeDir Directories="$(PublishDir)x86;$(PublishDir)x64" />
    <Copy SourceFiles="$(_PdfiumViewerNativeX86)" DestinationFiles="$(PublishDir)x86/pdfium.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_PdfiumViewerNativeX64)" DestinationFiles="$(PublishDir)x64/pdfium.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
